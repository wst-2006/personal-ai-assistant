# Do not commit real passwords or API keys.
DATABASE_URL=postgresql://personal_ai_app:replace-with-url-encoded-password@127.0.0.1:5432/personal_ai_assistant
EXPECTED_DB_HOST=127.0.0.1
EXPECTED_DB_PORT=5432
EXPECTED_DB_NAME=personal_ai_assistant
EXPECTED_DB_USER=personal_ai_app
EXPECTED_PG_MAJOR=18

# Server-only external integration settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=1200

# Optional server-only daily brief providers. GDELT is the free default for
# news. Brave is an optional enhancement, never a requirement.
BRAVE_SEARCH_API_KEY=

# Optional Feishu delivery. Keep real values only in the local/server .env.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TARGET_OPEN_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
APP_PUBLIC_URL=
