# Do not commit real passwords or API keys.
DATABASE_URL=postgresql://personal_ai_app:replace-with-url-encoded-password@127.0.0.1:5432/personal_ai_assistant
EXPECTED_DB_HOST=127.0.0.1
EXPECTED_DB_PORT=5432
EXPECTED_DB_NAME=personal_ai_assistant
EXPECTED_DB_USER=personal_ai_app
EXPECTED_PG_MAJOR=18

# Server-only external integration settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional. Configure this only after verifying the selected model accepts image
# input. Sleep screenshot analysis remains unavailable while this is blank.
DEEPSEEK_VISION_MODEL=
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
# Maximum user-authored background and AI guidance included in one model call.
DEEPSEEK_USER_CONTEXT_MAX_CHARS=6000

# Optional server-only daily brief providers. Tavily is recommended for fast,
# LLM-oriented search (its free tier is suitable for personal development).
# If Tavily is empty, Brave is tried; if both are empty, free GDELT is used.
TAVILY_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional Feishu reminders, interactive cards, and confirmed text intake.
# Keep real values only in the local/server .env. WebSocket is the local-first
# default: the API connects to Feishu directly and does not require a public
# URL or tunnel. To receive text, enable the `im.message.receive_v1` event in
# the Feishu app's event subscription settings.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TARGET_OPEN_ID=
# websocket | http
FEISHU_CALLBACK_TRANSPORT=websocket
FEISHU_WS_HANDSHAKE_TIMEOUT_MS=15000
FEISHU_WS_RETRY_BASE_MS=5000
FEISHU_WS_RETRY_MAX_MS=60000
# The following values are used only when FEISHU_CALLBACK_TRANSPORT=http.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Optional link for the card's "open task" button. A local desktop app does
# not need this value for reminders, Start, or Other arrangement actions.
APP_PUBLIC_URL=
