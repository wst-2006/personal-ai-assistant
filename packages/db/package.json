{
  "name": "@personal-ai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./migration-guard": {
      "types": "./dist/migration-guard.d.ts",
      "default": "./dist/migration-guard.js"
    },
    "./focus-no-response": {
      "types": "./dist/focus-no-response.d.ts",
      "default": "./dist/focus-no-response.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "verify": "tsx src/verify.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "vitest": "^3.0.7"
  }
}
