!define STOP_BUNDLED_RUNTIME_COMMAND ""

!macro StopPersonalAiRuntime
  ; Ask the app to exit first so it can stop its API and worker normally.
  !insertmacro CheckIfAppIsRunning "${MAINBINARYNAME}.exe" "${PRODUCTNAME}"

  ; A forcibly closed older release can leave its bundled Node processes alive.
  ; The helper matches the complete executable path and never stops system Node
  ; installations, development servers, or Codex processes.
  System::Call 'Kernel32::SetEnvironmentVariable(t,t)i("PERSONAL_AI_RUNTIME_NODE", "$INSTDIR\runtime\node.exe")'
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand "${STOP_BUNDLED_RUNTIME_COMMAND}"'
  Pop $R0
  Pop $R1
  System::Call 'Kernel32::SetEnvironmentVariable(t,t)i("PERSONAL_AI_RUNTIME_NODE", "")'
  ${If} $R0 != 0
    DetailPrint "Unable to stop the previous bundled runtime: $R1"
    MessageBox MB_ICONSTOP|MB_OK "无法关闭旧版个人 AI 助理的后台服务。请退出软件后重新运行安装程序。"
    Abort
  ${EndIf}
!macroend

!macro NSIS_HOOK_PREINSTALL
  !insertmacro StopPersonalAiRuntime
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro StopPersonalAiRuntime
!macroend
