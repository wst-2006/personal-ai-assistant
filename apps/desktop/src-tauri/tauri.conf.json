{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal AI Assistant",
  "version": "0.1.0",
  "identifier": "com.personalai.assistant",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev:local",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "个人 AI 助理",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
